# AyosPH Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# ============================================
# Database Configuration
# ============================================
# Supabase PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://user:password@host.supabase.co:5432/postgres

# ============================================
# Authentication (NextAuth.js)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-generated-secret-here

# Your application URL
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# ============================================
# API Configuration
# ============================================
# Public API URL (can be accessed from browser)
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# Email Configuration (Optional)
# ============================================
# Gmail Setup:
# 1. Enable 2-Factor Authentication
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use App Password as SMTP_PASSWORD

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=AyosPH

# Alternative: SendGrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDER_EMAIL=noreply@yourdomain.com

# Alternative: Resend (Recommended for Next.js)
# RESEND_API_KEY=re_your-resend-api-key

# ============================================
# File Upload Configuration
# ============================================
# For image uploads (photos of issues, proof of fix)
NEXT_PUBLIC_UPLOAD_BUCKET=ayosphph-uploads
NEXT_PUBLIC_UPLOAD_URL=https://storage.googleapis.com/ayosphph-uploads

# ============================================
# External Services (Optional)
# ============================================
# Google Maps (for location features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Analytics (Vercel Analytics)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id

# Sentry Error Tracking
SENTRY_AUTH_TOKEN=your-sentry-token

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_MOBILE_APP=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_FEEDBACK=false

# ============================================
# Development Only
# ============================================
# Set to 'development' for local, 'production' for deployed
NODE_ENV=development

# Debug mode
DEBUG=false
